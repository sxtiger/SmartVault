<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.aibrain.rag</string>

    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON@</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>rag_api:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8788</string>
        <string>--app-dir</string>
        <string>@PROJECT_DIR@</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@PROJECT_DIR@</string>

    <!-- 登录即启动；进程意外退出后 launchd 自动拉起 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- 日志必须位于 ~/Library/Logs/（@LOG_DIR@）：macOS TCC 禁止 launchd 打开
         ~/Documents 下的文件，否则作业在 exec 前即以 78 EX_CONFIG 秒退（v1.7.1 教训） -->
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/rag_api.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/rag_api.stderr.log</string>
</dict>
</plist>
