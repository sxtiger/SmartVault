# ===== 敏感 / 个人配置（勿上传；模板见 config.example.json）=====
config.json
.env
.env.*
*.pem
*.key
secrets/
ai_context.md

# ===== 真实测试样本（用户提供的手写 PDF/图片/标注，内容永不入库）=====
tmp/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# ===== 运行时产物（向量库 / 索引状态 / 日志 / 模型权重）=====
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# ===== macOS / 编辑器 =====
.DS_Store
.idea/
.vscode/
*.swp

# ===== 菜单栏 .app 构建产物（scripts/build_menubar_app.sh 生成）=====
*.app

# ===== 菜单栏单例锁 =====
logs/.menubar.lock

